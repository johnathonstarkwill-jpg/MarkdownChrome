{
  "manifest_version": 3,
  "name": "Markdown Chrome",
  "description": "View, edit, and save local Markdown files with Mermaid preview.",
  "version": "0.1.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": ["file:///*"],
  "action": {
    "default_title": "Open Markdown Chrome"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["src/content/file-detector.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/viewer/viewer.html"],
      "matches": ["file:///*"]
    }
  ]
}
